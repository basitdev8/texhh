# Database and authentication
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/techchasers
JWT_SECRET=replace-with-a-long-random-secret

# Shared rate limiting on Vercel (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Protects the Vercel cron endpoint that expires abandoned payment checkouts.
CRON_SECRET=replace-with-a-random-32-character-secret

# Cloudinary product-image storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Public storefront URL. Use the production URL when deployed.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="TechChasers <orders@your-verified-domain.com>"
RESEND_REPLY_TO=support@your-verified-domain.com
RESEND_ORDER_NOTIFICATION_EMAIL=owner@your-verified-domain.com

# Used by `npm run test-email`. Falls back to RESEND_ORDER_NOTIFICATION_EMAIL.
RESEND_TEST_TO=you@your-verified-domain.com
